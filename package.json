{
  "name": "arc-simple-payment",
  "version": "0.1.0",
  "description": "A minimal stablecoin payment demo built on Arc Testnet — sending USDC with on-chain memos via native value transfers.",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:arc": "hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:agentpay": "hardhat run scripts/deployAgentPay.js --network arcTestnet",
    "demo:agentpay": "hardhat run scripts/demoAgentPay.js --network arcTestnet",
    "send": "hardhat run scripts/sendPayment.js --network arcTestnet",
    "node": "hardhat node"
  },
  "keywords": [
    "arc",
    "arc-network",
    "circle",
    "stablecoin",
    "usdc",
    "payments",
    "ethers",
    "hardhat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
