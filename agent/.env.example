# Copy this file to .env in this folder and fill in values.
# DO NOT commit .env (already gitignored).

# === Required: agent's private key ===
# The agent must already be registered on the AgentPay contract,
# and at least one service must be in its allowlist.
# For demos, this is usually the same as your dev wallet's key.
AGENT_PRIVATE_KEY=

# === Optional: override defaults ===
# Arc Testnet RPC (default: https://rpc.testnet.arc.network)
# ARC_RPC_URL=

# AgentPay contract address
# (default: 0x1C0cf5a6d6b1EA6EDdF878Aef3e35c2b930f4D31 — our deployment)
# AGENTPAY_ADDRESS=

# Mock service receiver address
# (default: 0x81bC647e375556Ee8Cae2a4422a33379904e3341 — already whitelisted in demo)
# To use a different service, paste the address here AND make sure it's
# whitelisted on the agent via the frontend.
# MOCK_SERVICE_ADDR=

# === Optional: AI mode ===
# If set, the script uses Claude to plan the task dynamically.
# Get a key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Force demo (hardcoded) plan even if ANTHROPIC_API_KEY is set
# AGENT_MODE=demo
