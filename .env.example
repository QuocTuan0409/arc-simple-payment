# Copy this file to .env and fill in your values.
# NEVER commit your real .env file.

# Your deployer wallet private key (without 0x prefix is fine, with 0x is also fine).
# Get testnet USDC from https://faucet.circle.com (select Arc Testnet).
PRIVATE_KEY=

# Optional: override the default Arc Testnet RPC.
# Default: https://rpc.testnet.arc.network
ARC_RPC_URL=https://rpc.testnet.arc.network

# Optional: address to send a demo payment to when running scripts/sendPayment.js.
# Defaults to your own address if not set.
RECIPIENT_ADDRESS=
